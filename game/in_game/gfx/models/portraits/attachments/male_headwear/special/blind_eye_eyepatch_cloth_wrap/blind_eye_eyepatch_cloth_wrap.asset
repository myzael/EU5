pdxmesh = {
	name = "blind_eye_eyepatch_cloth_wrap_mesh"
	file = "blind_eye_eyepatch_cloth_wrap.mesh"

	meshsettings = {
		name = "blind_eye_eyepatch_cloth_wrapShape"
		index = 0
		texture_diffuse = "blind_eye_cloth_diffuse.dds"
		texture_normal = "blind_eye_cloth_normal.dds"
		texture_specular = "blind_eye_cloth_properties.dds"
		shader = "portrait_hair_transparency_hack"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
}

