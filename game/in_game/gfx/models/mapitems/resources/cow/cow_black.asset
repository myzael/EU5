pdxmesh = {
	name = "cow_black_mesh"
	file = "cow.mesh"

	animation = { id = "moving_animation" type = "cow_moving.anim" }
	animation = { id = "idle_animation" type = "cow_idle.anim" }

	lod_percentages = {
		lod = { index = 1 percent = 3.0 }
		lod = { index = 2 percent = 1.5 }
	}

	meshsettings = {
		name = "LOD_0|cow|cowShape"
		index = 0
		texture_diffuse = "cow_black_diffuse.dds"
		texture_normal = "european_cow_normal.dds"
		texture_specular = "cow_properties.dds"
		texture = { index = 3 srgb = no file = "tiger_mask.dds" }
		shader = "snap_to_terrain_no_deform"
	}

	meshsettings = {
		name = "LOD_1|cow|cowShape"
		index = 0
		texture_diffuse = "cow_black_diffuse.dds"
		texture_normal = "european_cow_normal.dds"
		texture_specular = "cow_properties.dds"
		texture = { index = 3 srgb = no file = "tiger_mask.dds" }
		shader = "snap_to_terrain_no_deform"
	}

	meshsettings = {
		name = "LOD_2|cow|cowShape"
		index = 0
		texture_diffuse = "cow_black_diffuse.dds"
		texture_normal = "european_cow_normal.dds"
		texture_specular = "cow_properties.dds"
		texture = { index = 3 srgb = no file = "tiger_mask.dds" }
		shader = "snap_to_terrain_no_deform"
	}

}


entity = {
	name = "cow_black_entity"
	pdxmesh = "cow_black_mesh"

	default_state = "moving"
	state = {
		name = "moving"
		animation = "moving_animation"
	}
	state = {
		name = "idle"
		animation = "idle_animation"
	}
}
